# Copia este archivo como .env y completa los valores. NUNCA subas el .env a git.

# Base de datos (Supabase > Project Settings > Database > Connection string > Transaction pooler, puerto 6543)
DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres

# Sesiones: una cadena larga y aleatoria (obligatoria con NODE_ENV=production)
# Generar una: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# development en local, production en Render
NODE_ENV=development
PORT=5000

# URL pública del portal (el QR del certificado apunta aquí). Debe empezar con https://
# En Render es opcional: si no se pone, se usa la URL del servicio (RENDER_EXTERNAL_URL).
PUBLIC_URL=http://localhost:5000

# ePayco Sandbox (Dashboard de ePayco > Integraciones > Llaves API)
EPAYCO_PUBLIC_KEY=
EPAYCO_P_KEY=
EPAYCO_CUSTOMER_ID=

# Interruptores: pon "off" para apagarlos
PAGO_MANUAL=on
MODO_DEMO=on

# Clave de los usuarios demo que crea seed.js (si no se pone, usa una de ejemplo)
SEED_PASSWORD=
